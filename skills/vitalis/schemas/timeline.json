{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitalis.local/schemas/timeline-1.0.json",
  "title": "Vitalis HealthTimeline 1.0",
  "type": "object",
  "required": ["user_id", "period_start", "period_end", "items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "type", "date", "title", "summary", "references", "details"],
        "properties": {
          "type": {"enum": ["analysis", "recommendation", "workout", "feedback", "event_transition", "training_response", "monthly_summary", "personal_association"]}
        }
      }
    }
  }
}

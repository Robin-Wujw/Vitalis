{
  "$defs": {
    "Availability": {
      "enum": [
        "AVAILABLE",
        "INSUFFICIENT_DATA"
      ],
      "title": "Availability",
      "type": "string"
    },
    "ConfidenceBand": {
      "enum": [
        "NONE",
        "LOW",
        "MODERATE",
        "HIGH"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "EventLifecycle": {
      "enum": [
        "DETECTED",
        "PERSISTING",
        "IMPROVING",
        "RESOLVED"
      ],
      "title": "EventLifecycle",
      "type": "string"
    },
    "EventSeverity": {
      "enum": [
        "INFO",
        "MODERATE",
        "HIGH"
      ],
      "title": "EventSeverity",
      "type": "string"
    },
    "EvidenceRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "applies_to": {
          "items": {
            "type": "string"
          },
          "title": "Applies To",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "url"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "HealthEvent": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "type_label": {
          "title": "Type Label",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/EventSeverity"
        },
        "severity_label": {
          "title": "Severity Label",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "metric_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Label"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "duration_days": {
          "minimum": 1,
          "title": "Duration Days",
          "type": "integer"
        },
        "deviation_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deviation Percent"
        },
        "baseline_window_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Window Days"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "confidence_label": {
          "title": "Confidence Label",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/HealthEventEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "lifecycle": {
          "$ref": "#/$defs/EventLifecycle",
          "default": "DETECTED"
        },
        "lifecycle_label": {
          "default": "已发现",
          "title": "Lifecycle Label",
          "type": "string"
        },
        "last_observed_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed Date"
        },
        "last_evaluated_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Evaluated Date"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "acknowledged": {
          "default": false,
          "title": "Acknowledged",
          "type": "boolean"
        },
        "acknowledged_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acknowledged At"
        }
      },
      "required": [
        "id",
        "type",
        "type_label",
        "severity",
        "severity_label",
        "start_date",
        "end_date",
        "duration_days",
        "confidence",
        "confidence_label",
        "summary"
      ],
      "title": "HealthEvent",
      "type": "object"
    },
    "HealthEventEvidence": {
      "properties": {
        "fact": {
          "title": "Fact",
          "type": "string"
        },
        "fact_label": {
          "title": "Fact Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "fact",
        "fact_label"
      ],
      "title": "HealthEventEvidence",
      "type": "object"
    },
    "MonthlyActions": {
      "properties": {
        "recommendations": {
          "items": {
            "$ref": "#/$defs/WeeklyRecommendation"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "MonthlyActions",
      "type": "object"
    },
    "MonthlyActivityFacts": {
      "properties": {
        "metrics": {
          "items": {
            "$ref": "#/$defs/PeriodActivityMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "available_days": {
          "maximum": 28,
          "minimum": 0,
          "title": "Available Days",
          "type": "integer"
        },
        "previous_available_days": {
          "default": 0,
          "maximum": 28,
          "minimum": 0,
          "title": "Previous Available Days",
          "type": "integer"
        },
        "total_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Steps"
        },
        "average_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Steps"
        },
        "previous_average_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Average Steps"
        },
        "steps_change_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps Change Percent"
        },
        "active_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Minutes"
        }
      },
      "required": [
        "available_days"
      ],
      "title": "MonthlyActivityFacts",
      "type": "object"
    },
    "MonthlyDataQuality": {
      "properties": {
        "status": {
          "$ref": "#/$defs/QualityStatus"
        },
        "status_label": {
          "title": "Status Label",
          "type": "string"
        },
        "sleep_days": {
          "maximum": 28,
          "minimum": 0,
          "title": "Sleep Days",
          "type": "integer"
        },
        "hrv_days": {
          "maximum": 28,
          "minimum": 0,
          "title": "Hrv Days",
          "type": "integer"
        },
        "activity_days": {
          "maximum": 28,
          "minimum": 0,
          "title": "Activity Days",
          "type": "integer"
        },
        "training_record_days": {
          "maximum": 28,
          "minimum": 0,
          "title": "Training Record Days",
          "type": "integer"
        },
        "training_days": {
          "anyOf": [
            {
              "maximum": 28,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Days"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "confidence_label": {
          "title": "Confidence Label",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "status",
        "status_label",
        "sleep_days",
        "hrv_days",
        "activity_days",
        "training_record_days",
        "confidence",
        "confidence_label"
      ],
      "title": "MonthlyDataQuality",
      "type": "object"
    },

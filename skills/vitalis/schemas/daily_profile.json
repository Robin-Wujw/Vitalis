{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitalis.local/schemas/daily-profile-6.0.json",
  "title": "Vitalis DailyProfile 6.0",
  "type": "object",
  "required": ["schema_version", "analysis_run_id", "intelligence_version", "decision_policy_version", "evidence_version", "user_id", "date", "generated_at", "data_quality", "facts", "baselines", "features", "trends", "events", "states", "decision", "evidence_refs", "metadata"],
  "properties": {
    "schema_version": {"const": "6.0"},
    "analysis_run_id": {"type": "string"},
    "intelligence_version": {"const": "6.0"},
    "decision_policy_version": {"const": "6.0"},
    "evidence_version": {"const": "2026-08c"},
    "user_id": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "data_quality": {
      "type": "object",
      "required": ["status", "status_label", "required_signals", "required_signal_labels", "missing_required_signals", "missing_required_signal_labels", "coverage", "flags", "device_validity"],
      "properties": {
        "status": {"enum": ["SUFFICIENT", "PARTIAL", "INSUFFICIENT"]},
        "status_label": {"type": "string"},
        "required_signals": {"type": "array", "items": {"type": "string"}},
        "required_signal_labels": {"type": "array", "items": {"type": "string"}},
        "missing_required_signals": {"type": "array", "items": {"type": "string"}},
        "missing_required_signal_labels": {"type": "array", "items": {"type": "string"}},
        "coverage": {"type": "array", "items": {"type": "object"}},
        "flags": {"type": "array", "items": {"type": "object"}},
        "device_validity": {"type": "array", "items": {"type": "object"}}
      }
    },
    "facts": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
    "baselines": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
    "trends": {"type": "array", "items": {"type": "object"}},
    "events": {"type": "array", "items": {"type": "object"}},
    "features": {
      "type": "object",
      "required": ["sleep", "hrv", "recovery", "training"],
      "properties": {
        "sleep": {
          "type": "object",
          "required": ["status", "status_label", "limitations", "limitation_labels"],
          "properties": {
            "status": {"enum": ["AVAILABLE", "INSUFFICIENT_DATA"]},
            "status_label": {"type": "string"},
            "limitations": {"type": "array", "items": {"type": "string"}},
            "limitation_labels": {"type": "array", "items": {"type": "string"}}
          }
        },
        "hrv": {
          "type": "object",
          "required": ["status", "status_label", "fusion_direction", "fusion_confidence", "fusion_confidence_label", "fusion_summary", "recent_7d_direction", "recent_7d_days", "previous_7d_days", "corroboration_status", "corroborating_stream_count", "corroboration_affects_decision", "streams", "heart_rate_coverage", "limitations", "limitation_labels"],
          "properties": {
            "status": {"enum": ["AVAILABLE", "INSUFFICIENT_DATA"]},
            "status_label": {"type": "string"},
            "preferred_device_label": {"type": ["string", "null"]},
            "fusion_method": {"enum": ["canonical_device_with_corroboration", null]},
            "fusion_direction": {"enum": ["above", "near", "below", "unknown"]},
            "fusion_confidence": {"enum": ["NONE", "LOW", "MODERATE", "HIGH"]},
            "fusion_confidence_label": {"type": "string"},
            "fusion_summary": {"type": "string"},
            "recent_7d_direction": {"enum": ["above", "near", "below", "unknown"]},
            "recent_7d_days": {"type": "integer", "minimum": 0, "maximum": 7},
            "previous_7d_days": {"type": "integer", "minimum": 0, "maximum": 7},
            "nocturnal_heart_rate": {"type": ["object", "null"]},
            "corroboration_status": {"enum": ["not_available", "consistent", "conflicting", "insufficient"]},
            "corroborating_stream_count": {"type": "integer", "minimum": 0},
            "corroboration_affects_decision": {"type": "boolean"},
            "limitations": {"type": "array", "items": {"type": "string"}},
            "limitation_labels": {"type": "array", "items": {"type": "string"}},
            "streams": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["metric", "device_label", "measurement_site", "value_ms", "sample_count_today", "baseline_distinct_days", "selected"]
              }
            },
            "heart_rate_coverage": {"type": "array", "items": {"type": "object"}}
          }
        },
        "recovery": {
          "type": "object",
          "required": ["status", "status_label", "state", "state_label", "positive_signal_labels", "negative_signal_labels", "limitation_labels"],
          "properties": {
            "status": {"enum": ["AVAILABLE", "INSUFFICIENT_DATA"]},
            "status_label": {"type": "string"},
            "state": {"enum": ["GOOD", "NORMAL", "SUPPRESSED", "INSUFFICIENT_DATA"]},
            "state_label": {"type": "string"},
            "positive_signal_labels": {"type": "array", "items": {"type": "string"}},
            "negative_signal_labels": {"type": "array", "items": {"type": "string"}},
            "limitation_labels": {"type": "array", "items": {"type": "string"}}
          }
        },
        "training": {
          "type": "object",
          "required": ["status", "status_label", "load_state", "load_state_label", "sport_mode_counts_7d", "recent_workouts", "running", "strength", "limitation_labels"],
          "properties": {
            "status": {"enum": ["AVAILABLE", "INSUFFICIENT_DATA"]},
            "status_label": {"type": "string"},
            "load_state": {"enum": ["LOW", "NORMAL", "ELEVATED", "INSUFFICIENT_DATA"]},
            "load_state_label": {"type": "string"},
            "workout_type_counts_7d": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "sport_mode_counts_7d": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "running": {
              "type": ["object", "null"],
              "properties": {
                "schema_version": {"const": "1.0"},
                "status": {"enum": ["AVAILABLE", "INSUFFICIENT_DATA"]},
                "zone_method": {"enum": ["lactate_threshold", "unavailable"]},
                "recent_sessions": {"type": "array", "items": {"type": "object"}},
                "limitations": {"type": "array", "items": {"type": "string"}}
              }
            },
            "strength": {
              "type": ["object", "null"],
              "properties": {
                "schema_version": {"const": "1.0"},
                "status": {"enum": ["AVAILABLE", "INSUFFICIENT_DATA"]},
                "sessions_7d": {"type": "integer", "minimum": 0},
                "sessions_28d": {"type": "integer", "minimum": 0},
                "explicit_session_coverage": {"type": "number", "minimum": 0, "maximum": 1},
                "detected_split": {"enum": ["FULL_BODY", "UPPER_LOWER", "PUSH_PULL_LEGS", "FIVE_DAY", "UNRESOLVED"]},
                "next_focus": {"type": ["string", "null"]},
                "recent_sessions": {"type": "array", "items": {"type": "object"}},
                "muscle_recovery": {"type": "array", "items": {"type": "object"}},
                "limitations": {"type": "array", "items": {"type": "string"}}
              }
            },
            "limitation_labels": {"type": "array", "items": {"type": "string"}},
            "recent_workouts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date", "type", "type_label", "sport_mode", "sport_mode_label", "training_family", "training_family_label", "recognition_confidence", "recognition_confidence_label", "recognition_source", "recognition_source_label", "duration_minutes", "vendor_load", "detail_available"],
                "properties": {
                  "date": {"type": "string", "format": "date"},
                  "type": {"type": "string"},
                  "type_label": {"type": "string"},
                  "sport_mode": {"type": "string"},
                  "sport_mode_label": {"type": "string"},
                  "training_family": {"type": "string"},
                  "training_family_label": {"type": "string"},
                  "recognition_confidence": {"enum": ["NONE", "HIGH"]},
                  "recognition_confidence_label": {"type": "string"},
                  "recognition_source": {"type": "string"},
                  "recognition_source_label": {"type": "string"},
                  "duration_minutes": {"type": "integer", "minimum": 0},
                  "vendor_load": {"type": "number", "minimum": 0},
                  "detail_available": {"type": "boolean"}
                }
              }
            }
          }
        }
      }
    },
    "states": {
      "type": "object",
      "required": ["sleep", "recovery", "training_load", "sleep_label", "recovery_label", "training_load_label"],
      "properties": {
        "sleep_label": {"type": "string"},
        "recovery_label": {"type": "string"},
        "training_load_label": {"type": "string"}
      }
    },
    "decision": {
      "type": "object",
      "required": ["recommendation_id", "action", "action_label", "confidence", "confidence_label", "drivers", "driver_labels", "limitations", "limitation_labels", "rule_ids", "action_plan"],
      "properties": {
        "recommendation_id": {"type": "string"},
        "action": {"enum": ["TRAIN_HARD", "TRAIN_NORMAL", "TRAIN_LIGHT", "RECOVERY", "REST", "INSUFFICIENT_DATA"]},
        "action_label": {"type": "string"},
        "confidence": {"enum": ["NONE", "LOW", "MODERATE", "HIGH"]},
        "confidence_label": {"type": "string"},
        "drivers": {"type": "array", "items": {"type": "string"}},
        "driver_labels": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "limitation_labels": {"type": "array", "items": {"type": "string"}},
        "rule_ids": {"type": "array", "items": {"type": "string"}},
        "action_plan": {
          "type": "object",
          "required": ["schema_version", "goal", "goal_label", "valid_for_date", "expires_at", "safety_status", "safety_status_label", "weekly_balance", "primary_session", "optional_session", "session_relationship", "session_relationship_label", "conflict_checks", "missing_input_gates"],
          "properties": {
            "schema_version": {"const": "2.0"},
            "goal": {"const": "HEALTH_FIRST_CONCURRENT"},
            "goal_label": {"type": "string"},
            "valid_for_date": {"type": "string", "format": "date"},
            "expires_at": {"type": "string", "format": "date-time"},
            "safety_status": {"enum": ["CLEAR", "LIMITED", "UNKNOWN"]},
            "safety_status_label": {"type": "string"},
            "weekly_balance": {
              "type": "object",
              "required": ["running_completed_7d", "running_target_7d", "running_completed_28d", "running_target_28d", "strength_completed_7d", "strength_target_7d", "strength_completed_28d", "strength_target_28d", "running_due", "strength_due"]
            },
            "primary_session": {"type": ["object", "null"]},
            "optional_session": {"type": ["object", "null"]},
            "session_relationship": {"enum": ["ADDITION", "ALTERNATIVE", "NONE"]},
            "session_relationship_label": {"type": "string"},
            "conflict_checks": {"type": "array", "items": {"type": "string"}},
            "missing_input_gates": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "metadata": {"type": "object"}
  }
}

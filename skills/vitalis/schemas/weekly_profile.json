{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitalis.local/schemas/weekly-profile-1.0.json",
  "title": "Vitalis WeeklyProfile 1.0",
  "type": "object",
  "required": ["schema_version", "model_version", "user_id", "period_start", "period_end", "generated_at", "data_quality", "facts", "inferences", "actions", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "model_version": {"const": "vitalis-weekly-1"},
    "user_id": {"type": "string"},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "data_quality": {"type": "object", "required": ["status", "status_label", "confidence", "confidence_label", "limitations"]},
    "facts": {
      "type": "object",
      "required": ["sleep", "recovery", "training", "activity", "feedback"]
    },
    "inferences": {
      "type": "object",
      "required": ["trends", "events", "key_changes", "limitations"]
    },
    "actions": {
      "type": "object",
      "required": ["recommendations"],
      "properties": {
        "recommendations": {"type": "array", "items": {"type": "object", "required": ["priority", "code", "title", "action", "reasons"]}}
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "object"}}
  }
}

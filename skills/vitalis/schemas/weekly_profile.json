{
  "$defs": {
    "Availability": {
      "enum": [
        "AVAILABLE",
        "INSUFFICIENT_DATA"
      ],
      "title": "Availability",
      "type": "string"
    },
    "ConfidenceBand": {
      "enum": [
        "NONE",
        "LOW",
        "MODERATE",
        "HIGH"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "DailySleepHrvPoint": {
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "value_ms": {
          "exclusiveMinimum": 0,
          "title": "Value Ms",
          "type": "number"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        }
      },
      "required": [
        "date",
        "value_ms",
        "sample_count"
      ],
      "title": "DailySleepHrvPoint",
      "type": "object"
    },
    "EventLifecycle": {
      "enum": [
        "DETECTED",
        "PERSISTING",
        "IMPROVING",
        "RESOLVED"
      ],
      "title": "EventLifecycle",
      "type": "string"
    },
    "EventSeverity": {
      "enum": [
        "INFO",
        "MODERATE",
        "HIGH"
      ],
      "title": "EventSeverity",
      "type": "string"
    },
    "EvidenceRef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "applies_to": {
          "items": {
            "type": "string"
          },
          "title": "Applies To",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "url"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "HealthEvent": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "type_label": {
          "title": "Type Label",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/EventSeverity"
        },
        "severity_label": {
          "title": "Severity Label",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "metric_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Label"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "duration_days": {
          "minimum": 1,
          "title": "Duration Days",
          "type": "integer"
        },
        "deviation_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deviation Percent"
        },
        "baseline_window_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Window Days"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "confidence_label": {
          "title": "Confidence Label",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/HealthEventEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "lifecycle": {
          "$ref": "#/$defs/EventLifecycle",
          "default": "DETECTED"
        },
        "lifecycle_label": {
          "default": "已发现",
          "title": "Lifecycle Label",
          "type": "string"
        },
        "last_observed_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Observed Date"
        },
        "last_evaluated_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Evaluated Date"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "acknowledged": {
          "default": false,
          "title": "Acknowledged",
          "type": "boolean"
        },
        "acknowledged_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acknowledged At"
        }
      },
      "required": [
        "id",
        "type",
        "type_label",
        "severity",
        "severity_label",
        "start_date",
        "end_date",
        "duration_days",
        "confidence",
        "confidence_label",
        "summary"
      ],
      "title": "HealthEvent",
      "type": "object"
    },
    "HealthEventEvidence": {
      "properties": {
        "fact": {
          "title": "Fact",
          "type": "string"
        },
        "fact_label": {
          "title": "Fact Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "fact",
        "fact_label"
      ],
      "title": "HealthEventEvidence",
      "type": "object"
    },
    "OpenHealthCoverage": {
      "description": "Typed coverage summary used by period reports, not a recomputation.",
      "properties": {
        "window_days": {
          "minimum": 0,
          "title": "Window Days",
          "type": "integer"
        },
        "observed_days": {
          "minimum": 0,
          "title": "Observed Days",
          "type": "integer"
        },
        "required_days": {
          "minimum": 0,
          "title": "Required Days",
          "type": "integer"
        },
        "ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ratio",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/OpenHealthStatus"
        }
      },
      "required": [
        "window_days",
        "observed_days",
        "required_days",
        "ratio",
        "status"
      ],
      "title": "OpenHealthCoverage",
      "type": "object"
    },
    "OpenHealthPeriodSummary": {
      "properties": {
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_days": {
          "minimum": 0,
          "title": "Period Days",
          "type": "integer"
        },
        "scope": {
          "const": "TARGET_DAY_WITH_PERIOD_COVERAGE",
          "default": "TARGET_DAY_WITH_PERIOD_COVERAGE",
          "title": "Scope",
          "type": "string"
        },
        "target_date": {
          "format": "date",
          "title": "Target Date",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OpenHealthStatus"
        },
        "drivers": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Drivers",
          "type": "array"
        },
        "refusal_reasons": {
          "items": {
            "$ref": "#/$defs/OpenHealthRefusalReason"
          },
          "maxItems": 4,
          "title": "Refusal Reasons",
          "type": "array"
        }
      },
      "required": [
        "period_start",
        "period_end",
        "period_days",
        "target_date",
        "status"
      ],
      "title": "OpenHealthPeriodSummary",
      "type": "object"
    },
    "OpenHealthRefusalReason": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "missing_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Missing Inputs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "OpenHealthRefusalReason",
      "type": "object"
    },
    "OpenHealthStatus": {
      "enum": [
        "AVAILABLE",
        "PARTIAL",
        "REFUSED"
      ],
      "title": "OpenHealthStatus",
      "type": "string"
    },
    "PeriodActivityMetric": {
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "daily_total",
                "activity",
                "workout",
                "unspecified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "source_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field"
        },
        "period_days": {
          "minimum": 1,
          "title": "Period Days",
          "type": "integer"
        },
        "available_days": {
          "minimum": 0,
          "title": "Available Days",
          "type": "integer"
        },
        "complete_days": {
          "minimum": 0,
          "title": "Complete Days",
          "type": "integer"
        },
        "previous_available_days": {
          "default": 0,
          "minimum": 0,
          "title": "Previous Available Days",
          "type": "integer"
        },
        "previous_complete_days": {
          "default": 0,
          "minimum": 0,
          "title": "Previous Complete Days",
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "average": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average"
        },
        "previous_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Total"
        },
        "previous_average": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Average"
        },
        "change_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Percent"
        },
        "total_change_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Change Percent"
        },
        "totals_are_partial": {
          "default": true,
          "title": "Totals Are Partial",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "metric",
        "unit",
        "provenance",
        "period_days",
        "available_days",
        "complete_days"
      ],
      "title": "PeriodActivityMetric",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_scope": {
          "default": "unknown",
          "title": "Source Scope",
          "type": "string"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        }
      },
      "required": [
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "SUFFICIENT",
        "PARTIAL",
        "INSUFFICIENT"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "TrendDirection": {
      "enum": [
        "RISING",
        "STABLE",
        "FALLING",
        "INSUFFICIENT_DATA"
      ],
      "title": "TrendDirection",
      "type": "string"
    },
    "TrendFeature": {
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "metric_label": {
          "title": "Metric Label",
          "type": "string"
        },
        "window_days": {
          "enum": [
            7,
            28,
            90
          ],
          "title": "Window Days",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_scope": {
          "title": "Source Scope",
          "type": "string"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Availability"
        },
        "status_label": {
          "title": "Status Label",
          "type": "string"
        },
        "current_distinct_days": {
          "minimum": 0,
          "title": "Current Distinct Days",
          "type": "integer"
        },
        "previous_distinct_days": {
          "minimum": 0,
          "title": "Previous Distinct Days",
          "type": "integer"
        },
        "minimum_days": {
          "minimum": 1,
          "title": "Minimum Days",
          "type": "integer"
        },
        "coverage_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Ratio",
          "type": "number"
        },
        "current_median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Median"
        },
        "previous_median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Median"
        },
        "change_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Percent"
        },
        "slope_per_day": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slope Per Day"
        },
        "variability_mad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variability Mad"
        },
        "direction": {
          "$ref": "#/$defs/TrendDirection"
        },
        "direction_label": {
          "title": "Direction Label",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "confidence_label": {
          "title": "Confidence Label",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "metric_label",
        "window_days",
        "source",
        "source_scope",
        "unit",
        "status",
        "status_label",
        "current_distinct_days",
        "previous_distinct_days",
        "minimum_days",
        "coverage_ratio",
        "direction",
        "direction_label",
        "confidence",
        "confidence_label"
      ],
      "title": "TrendFeature",
      "type": "object"
    },
    "WeeklyActions": {
      "properties": {
        "recommendations": {
          "items": {
            "$ref": "#/$defs/WeeklyRecommendation"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "WeeklyActions",
      "type": "object"
    },
    "WeeklyActivityFacts": {
      "properties": {
        "metrics": {
          "items": {
            "$ref": "#/$defs/PeriodActivityMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "available_days": {
          "maximum": 7,
          "minimum": 0,
          "title": "Available Days",
          "type": "integer"
        },
        "previous_available_days": {
          "default": 0,
          "maximum": 7,
          "minimum": 0,
          "title": "Previous Available Days",
          "type": "integer"
        },
        "total_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Steps"
        },
        "average_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Steps"
        },
        "previous_average_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Average Steps"
        },
        "steps_change_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps Change Percent"
        },
        "active_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Minutes"
        }
      },
      "required": [
        "available_days"
      ],
      "title": "WeeklyActivityFacts",
      "type": "object"
    },
    "WeeklyDataQuality": {
      "properties": {
        "status": {
          "$ref": "#/$defs/QualityStatus"
        },
        "status_label": {
          "title": "Status Label",
          "type": "string"
        },
        "sleep_days": {
          "maximum": 7,
          "minimum": 0,
          "title": "Sleep Days",
          "type": "integer"
        },
        "hrv_days": {
          "maximum": 7,
          "minimum": 0,
          "title": "Hrv Days",
          "type": "integer"
        },
        "activity_days": {
          "maximum": 7,
          "minimum": 0,
          "title": "Activity Days",
          "type": "integer"
        },
        "training_days": {
          "maximum": 7,
          "minimum": 0,
          "title": "Training Days",
          "type": "integer"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "confidence_label": {
          "title": "Confidence Label",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "status",
        "status_label",
        "sleep_days",
        "hrv_days",
        "activity_days",
        "training_days",
        "confidence",
        "confidence_label"
      ],
      "title": "WeeklyDataQuality",
      "type": "object"
    },
    "WeeklyFacts": {
      "properties": {
        "sleep": {
          "$ref": "#/$defs/WeeklySleepFacts"
        },
        "recovery": {
          "$ref": "#/$defs/WeeklyRecoveryFacts"
        },
        "training": {
          "$ref": "#/$defs/WeeklyTrainingFacts"
        },
        "activity": {
          "$ref": "#/$defs/WeeklyActivityFacts"
        },
        "feedback": {
          "$ref": "#/$defs/WeeklyFeedbackFacts"
        }
      },
      "required": [
        "sleep",
        "recovery",
        "training",
        "activity",
        "feedback"
      ],
      "title": "WeeklyFacts",
      "type": "object"
    },
    "WeeklyFeedbackFacts": {
      "properties": {
        "response_count": {
          "minimum": 0,
          "title": "Response Count",
          "type": "integer"
        },
        "average_session_rpe": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Session Rpe"
        },
        "average_physical_fatigue": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Physical Fatigue"
        },
        "average_mental_state": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Mental State"
        },
        "average_muscle_soreness": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Muscle Soreness"
        }
      },
      "required": [
        "response_count"
      ],
      "title": "WeeklyFeedbackFacts",
      "type": "object"
    },
    "WeeklyInferences": {
      "properties": {
        "trends": {
          "items": {
            "$ref": "#/$defs/TrendFeature"
          },
          "title": "Trends",
          "type": "array"
        },

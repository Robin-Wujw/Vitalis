[Unit]
Description=Vitalis scheduled sync and analysis worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vitalis
Group=vitalis
StateDirectory=vitalis
WorkingDirectory=/var/lib/vitalis
EnvironmentFile=/etc/vitalis/vitalis.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/vitalis/.venv/bin/vitalis worker
Restart=on-failure
RestartSec=5
MemoryHigh=250M
MemoryMax=320M
MemorySwapMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vitalis

[Install]
WantedBy=multi-user.target

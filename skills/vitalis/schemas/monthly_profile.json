        "average_muscle_soreness": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Muscle Soreness"
        }

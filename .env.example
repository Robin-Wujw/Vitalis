# ==== 运行环境 ====
VITALIS_ENV=dev

# ==== 本地存储；真实用户库请放到独立的受保护目录 ====
DATABASE_URL=sqlite:///./vitalis.db
# PostgreSQL 仅在部署方完成相应数据库验证后使用：
# DATABASE_URL=postgresql+psycopg://vitalis:YOUR_PASSWORD@localhost:5432/vitalis

# ==== Zepp 连接器 ====
# 真实云端 API 模式（需 Zepp 开发者/商户凭据，开放平台 openapi.zepp.com）
ZEPP_APP_ID=
ZEPP_APP_SECRET=
ZEPP_ACCESS_TOKEN=
# 扫码授权（OAuth2 授权码）回调地址：Zepp 授权后跳回此 URL 携带 code/state
ZEPP_REDIRECT_URI=http://localhost:8000/api/connect/zepp/callback
# 申请到的数据权限 scope（多个用空格分隔）
ZEPP_SCOPE=user.sleep user.activity user.training user.hr
# mock 仅用于 dev/test；生产设置 VITALIS_ENV=prod、ZEPP_MOCK=false 和独立密钥。
ZEPP_MOCK=true
# 真实连接前必须从私有环境提供 Fernet 密钥，密钥不得提交到仓库。
VITALIS_TOKEN_ENCRYPTION_KEY=
# OAuth state 单次消费且短期有效（分钟）。
ZEPP_OAUTH_STATE_TTL_MINUTES=10

# ==== 扫码登录说明 ====
# 1. POST /api/connect/zepp/pair (manage scope) -> 获取短时扫码 URL
# 2. 扩展在官方 Zepp 页面读取登录会话后提交一次性配对码
# 3. 模拟模式的回调使用 /api/connect/zepp/callback?code=..&state=..
#    -> 换 token 并保存到 auth_tokens 表，创建同步任务；worker 执行同步

# 分析由确定性规则引擎运行，不需要外部 LLM 凭据。

# ==== 调度（每日凌晨同步） ====
SYNC_CRON_HOUR=2
SYNC_CRON_MINUTE=0
# 一个 PushPlus 令牌只能投递给显式绑定的本地用户。
# 未同时设置以下两项时，内置报表投递保持禁用；Hermes 私有配置独立。
VITALIS_PUSH_USER=
PUSHPLUS_TOKEN=
# Optional PushPlus status-query credential; it is not a send token.
PUSHPLUS_ACCESS_KEY=
PUSHPLUS_QUERY_MAX_ATTEMPTS=3
PUSHPLUS_QUERY_INTERVAL_SECONDS=60
# 周报/月报自动推送默认关闭；启用后分别在周一和每月 1 日按本地时间排队。
VITALIS_WEEKLY_REPORT_ENABLED=false
VITALIS_WEEKLY_REPORT_HOUR=10
VITALIS_WEEKLY_REPORT_MINUTE=0
VITALIS_MONTHLY_REPORT_ENABLED=false
VITALIS_MONTHLY_REPORT_HOUR=10
VITALIS_MONTHLY_REPORT_MINUTE=30

# ==== 服务 ====
# 保持回环地址监听。公开部署必须先配 HTTPS 和有范围的访问令牌。
HOST=127.0.0.1
PORT=8000
VITALIS_PUBLIC_URL=
# Exact browser origins accepted by pairing credential endpoints, comma-separated.
# Include the deployed extension origin (chrome-extension://<32-char-id>) when used.
VITALIS_PAIRING_ALLOWED_ORIGINS=https://watchface.zepp.com,https://user.huami.com
ZEPP_PAIRING_RATE_LIMIT_ATTEMPTS=12
ZEPP_PAIRING_RATE_LIMIT_WINDOW_SECONDS=60

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitalis.local/schemas/health-events-1.0.json",
  "title": "Vitalis HealthEventResponse 1.0",
  "type": "object",
  "required": ["user_id", "period_start", "period_end", "generated_at", "events"],
  "properties": {
    "user_id": {"type": "string"},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "type_label", "severity", "severity_label", "start_date", "end_date", "duration_days", "confidence", "confidence_label", "summary", "evidence", "acknowledged"]
      }
    }
  }
}

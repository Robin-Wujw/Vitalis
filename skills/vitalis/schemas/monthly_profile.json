            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Physical Fatigue"
        },
        "average_mental_state": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,

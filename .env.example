# ==== 运行环境 ====
VITALIS_ENV=dev

# ==== 存储层（初期 PostgreSQL，开发可切 sqlite） ====
# PostgreSQL:
DATABASE_URL=postgresql+psycopg://vitalis:vitalis@localhost:5432/vitalis
# 开发/测试用 SQLite:
# DATABASE_URL=sqlite:///./vitalis.db

# ==== Zepp 连接器 ====
# 真实云端 API 模式（需 Zepp 开发者/商户凭据，开放平台 openapi.zepp.com）
ZEPP_APP_ID=
ZEPP_APP_SECRET=
ZEPP_ACCESS_TOKEN=
# 扫码授权（OAuth2 授权码）回调地址：Zepp 授权后跳回此 URL 携带 code/state
ZEPP_REDIRECT_URI=http://localhost:8000/api/v1/connect/zepp/callback
# 申请到的数据权限 scope（多个用空格分隔）
ZEPP_SCOPE=user.sleep user.activity user.training user.hr
# mock 模式：无需凭据，本地模拟扫码+数据，用于开发与测试（true/false）
ZEPP_MOCK=true

# ==== 扫码登录说明 ====
# 1. GET  /api/v1/connect/zepp/authorize -> 获取扫码 URL（渲染二维码）
# 2. 用户用 Zepp App 扫码授权
# 3. Zepp 回调 /api/v1/connect/zepp/callback?code=..&state=..
#    -> 自动换 token 并保存到 auth_tokens 表，随后自动同步数据

# ==== 分析引擎 ====
# Rule / Statistical 引擎无需配置。
# AI Engine（LLM 只负责解释，不负责计算）：
# 留空则 AI 分析返回"未配置 LLM"，纯规则+统计结果仍可用。
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ==== 调度（每日凌晨同步） ====
SYNC_CRON_HOUR=2
SYNC_CRON_MINUTE=0

# ==== 服务 ====
# 公网部署时让应用只监听回环地址，由 HTTPS 反向代理或隧道提供公网入口。
HOST=127.0.0.1
PORT=8000
VITALIS_PUBLIC_URL=https://health.example.com

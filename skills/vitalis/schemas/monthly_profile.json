          "title": "Metric Label",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_scope": {
          "title": "Source Scope",
          "type": "string"
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Id"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "available_days": {
          "maximum": 28,
          "minimum": 0,
          "title": "Available Days",
          "type": "integer"
        },
        "previous_available_days": {
          "maximum": 28,
          "minimum": 0,
          "title": "Previous Available Days",

    "MonthlyInferences": {
      "properties": {
        "trends": {
          "items": {
            "$ref": "#/$defs/TrendFeature"
          },
          "title": "Trends",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/HealthEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "personal_associations": {
          "items": {
            "$ref": "#/$defs/PersonalAssociation"
          },
          "title": "Personal Associations",
          "type": "array"
        },
        "key_changes": {
          "items": {
            "type": "string"
          },
          "title": "Key Changes",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "title": "MonthlyInferences",
